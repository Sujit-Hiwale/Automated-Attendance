# Environment Variables for Automated Attendance System
# Note: In production, these values should be stored in a secure vault

# Secret pepper for password hashing (base64 or hex encoded)
PEPPER_SECRET=<base64-or-hex-secret-from-vault>

# User agent for Have I Been Pwned API requests
HIBP_USER_AGENT="AutomatedAttendanceSystem"

# Redis Configuration for Rate Limiting and Brute Force Protection
REDIS_URL=redis://localhost:6379/0

# Brute Force Protection Settings
MAX_LOGIN_FAILS=5
LOCKOUT_BASE_SECONDS=60
MAX_LOCK_SECONDS=86400
CAPTCHA_THRESHOLD=3

# Password Security Settings
PWNED_THRESHOLD=0

# Rate Limiting Settings
LOGIN_RATE_LIMIT=20 per minute
REGISTRATION_RATE_LIMIT=5 per hour
API_RATE_LIMIT=100 per minute

# Database Security Configuration
# For PostgreSQL production (recommended)
# DATABASE_URL=postgresql+psycopg2://app_user:secure_password@localhost:5432/attendance_db?sslmode=require

# For SQLite development (default)
DATABASE_URL=sqlite:///./data/attendance.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# SSL Configuration for PostgreSQL
DB_SSL_MODE=prefer
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem  
# DB_SSL_ROOT_CERT=/path/to/ca-cert.pem

# Database Encryption Key for sensitive data (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DB_ENCRYPTION_KEY=<generate-fernet-key-here>

# Database Debug Settings (disable in production)
DB_ECHO=false

# Backup Configuration
BACKUP_ENCRYPTION_KEY=<generate-backup-key-here>
BACKUP_STORAGE_PATH=/secure/backups/
# For cloud storage (AWS S3, Google Cloud, etc.)
# BACKUP_CLOUD_BUCKET=your-backup-bucket
# BACKUP_CLOUD_REGION=us-east-1